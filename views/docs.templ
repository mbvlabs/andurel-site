package views

import (
	documentation "andurel-site/docs"
	"andurel-site/router/routes"
)

templ Documentation(site *documentation.Site, document *documentation.Document) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		@SetupHead(ctx, SetTitle(document.Title), SetDescription(document.Description), SetSlug(document.URL()))
		<body class="min-h-screen bg-[#090b0d] text-[#e4dfd2]">
			<a class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:bg-[#8df7a4] focus:px-3 focus:py-2 focus:text-[#090b0d]" href="#documentation-content">Skip to content</a>
			<header class="sticky top-0 z-40 border-b border-[#2f3a37] bg-[#090b0d]/95 backdrop-blur">
				<div class="mx-auto flex h-16 w-full max-w-[1440px] items-center justify-between gap-4 px-4 lg:px-6">
					<div class="flex items-center gap-4">
						<button class="grid size-9 place-items-center border border-[#2f3a37] text-[#aaa393] lg:hidden" type="button" data-docs-nav-open aria-label="Open documentation navigation">☰</button>
						<a class="inline-flex items-center gap-3 text-sm font-semibold text-[#f2ead8]" href={ routes.HomePage.URL() }>
							<span class="grid size-8 grid-cols-2 gap-1 border border-[#52605c] bg-[#101414] p-1 shadow-sm shadow-black/40">
								<span class="border border-[#8df7a4]"></span>
								<span class="border border-[#52605c]"></span>
								<span class="border border-[#52605c]"></span>
								<span class="bg-[#8df7a4]"></span>
							</span>
							<span>Andurel.</span>
							<span class="font-normal text-[#8f8a7d]">Docs</span>
						</a>
					</div>
					<div class="flex items-center gap-2">
						<button class="flex h-9 w-10 shrink-0 items-center gap-2 whitespace-nowrap border border-[#2f3a37] bg-[#101414] px-3 text-left text-sm text-[#8f8a7d] transition hover:border-[#52605c] hover:text-[#f2ead8] sm:w-40" type="button" data-docs-search-open>
							<span aria-hidden="true">⌕</span><span class="hidden flex-1 sm:inline">Search</span><kbd class="hidden font-mono text-xs lg:inline">⌘K</kbd>
						</button>
						<details class="relative">
							<summary class="flex h-9 cursor-pointer list-none items-center border border-[#2f3a37] bg-[#101414] px-3 font-mono text-xs text-[#aaa393]">{ document.Version }</summary>
							<div class="absolute right-0 top-11 min-w-28 border border-[#2f3a37] bg-[#101414] p-1 shadow-xl shadow-black/50">
								for _, version := range site.Versions() {
									<a class="block px-3 py-2 text-xs text-[#aaa393] hover:bg-[#171c1b] hover:text-[#f2ead8]" href={ "/docs/" + version.Name }>{ version.Name }</a>
								}
							</div>
						</details>
						<a class="hidden px-2 py-2 text-sm text-[#aaa393] hover:text-[#f2ead8] md:block" href="https://github.com/mbvlabs/andurel">GitHub</a>
					</div>
				</div>
			</header>
			<div class="mx-auto grid w-full max-w-[1440px] grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,1fr)_13rem]">
				<aside class="hidden border-r border-[#2f3a37] lg:block">
					<div class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto px-5 py-8">
						@docsNavigation(site, document)
					</div>
				</aside>
				<main id="documentation-content" class="min-w-0 px-5 py-10 sm:px-8 lg:px-12 xl:px-14">
					<div class="mx-auto max-w-3xl">
						<div class="mb-7 font-mono text-xs font-semibold uppercase tracking-[0.14em] text-[#8df7a4]">{ document.Section } / { document.Version }</div>
						<article class="docs-content">
							@templ.Raw(document.HTML)
						</article>
						<nav class="mt-14 grid gap-3 border-t border-[#2f3a37] pt-6 sm:grid-cols-2" aria-label="Documentation pagination">
							if document.Previous != nil {
								<a class="border border-[#2f3a37] bg-[#101414]/70 p-4 text-sm text-[#aaa393] transition hover:border-[#52605c] hover:text-[#f2ead8]" href={ document.Previous.URL }>
									<span class="mb-1 block font-mono text-[0.7rem] uppercase tracking-wider text-[#8f8a7d]">Previous</span>
									← { document.Previous.Title }
								</a>
							} else {
								<span></span>
							}
							if document.Next != nil {
								<a class="border border-[#2f3a37] bg-[#101414]/70 p-4 text-right text-sm text-[#aaa393] transition hover:border-[#52605c] hover:text-[#f2ead8]" href={ document.Next.URL }>
									<span class="mb-1 block font-mono text-[0.7rem] uppercase tracking-wider text-[#8f8a7d]">Next</span>
									{ document.Next.Title } →
								</a>
							}
						</nav>
					</div>
				</main>
				<aside class="hidden border-l border-[#2f3a37] xl:block">
					<nav class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto px-5 py-8" aria-label="On this page">
						<p class="mb-4 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-[#8df7a4]">On this page</p>
						<div class="space-y-2 border-l border-[#2f3a37]">
							for _, heading := range document.Headings {
								<a class={ "block border-l border-transparent py-1 text-xs leading-5 text-[#8f8a7d] transition hover:border-[#8df7a4] hover:text-[#f2ead8]", templ.KV("pl-6", heading.Level == 3), templ.KV("pl-4", heading.Level == 2) } href={ templ.SafeURL("#" + heading.ID) }>{ heading.Text }</a>
							}
						</div>
					</nav>
				</aside>
			</div>
			<dialog id="docs-nav" class="m-0 h-full max-h-none w-[min(22rem,88vw)] max-w-none border-r border-[#2f3a37] bg-[#090b0d] p-0 text-[#e4dfd2] backdrop:bg-black/70">
				<div class="flex items-center justify-between border-b border-[#2f3a37] px-5 py-4"><strong>Documentation</strong><button class="px-2 py-1 text-[#aaa393]" type="button" data-dialog-close aria-label="Close navigation">✕</button></div>
				<div class="h-[calc(100vh-4rem)] overflow-y-auto p-5">
					@docsNavigation(site, document)
				</div>
			</dialog>
			<dialog id="docs-search" class="fixed inset-0 m-auto max-h-[min(30rem,calc(100%-4rem))] w-[min(32rem,calc(100%-2rem))] border border-[#52605c] bg-[#101414] p-0 text-[#e4dfd2] shadow-2xl shadow-black/70 backdrop:bg-black/75">
				<div class="flex items-center gap-3 border-b border-[#2f3a37] p-4">
					<span class="text-[#8df7a4]" aria-hidden="true">⌕</span>
					<label class="sr-only" for="docs-search-input">Search documentation</label>
					<input id="docs-search-input" class="min-w-0 flex-1 bg-transparent text-base text-[#f2ead8] outline-none placeholder:text-[#8f8a7d]" type="search" placeholder="Search documentation" autocomplete="off"/>
					<button class="border border-[#2f3a37] px-2 py-1 font-mono text-xs text-[#8f8a7d]" type="button" data-dialog-close>ESC</button>
				</div>
				<div id="docs-search-results" class="max-h-[60vh] overflow-y-auto p-2" aria-live="polite"><p class="px-3 py-8 text-center text-sm text-[#8f8a7d]">Start typing to search the documentation.</p></div>
			</dialog>
		</body>
	</html>
}

templ docsNavigation(site *documentation.Site, current *documentation.Document) {
	<nav aria-label="Documentation navigation">
		for _, version := range site.Versions() {
			if version.Name == current.Version {
				for _, section := range version.Sections {
					<section class="mb-8">
						<h2 class="mb-3 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-[#8df7a4]">{ section.Title }</h2>
						<ul class="space-y-1 border-l border-[#2f3a37]">
							for _, page := range section.Pages {
								<li>
									if page.Slug == current.Slug {
										<a class="-ml-px block border-l border-[#ff6b1a] bg-[#15110e] py-1.5 pl-4 text-sm text-[#f2ead8]" href={ "/docs/" + version.Name + "/" + page.Slug } aria-current="page">{ page.Title }</a>
									} else {
										<a class="-ml-px block border-l border-transparent py-1.5 pl-4 text-sm text-[#8f8a7d] transition hover:border-[#52605c] hover:text-[#f2ead8]" href={ "/docs/" + version.Name + "/" + page.Slug }>{ page.Title }</a>
									}
								</li>
							}
						</ul>
					</section>
				}
			}
		}
	</nav>
}
