package views

import (
	"github.com/mbvlabs/andurel/pkg/inertia"
	"github.com/mbvlabs/andurel/pkg/server"
)

// Root is the application-owned initial Inertia document. Customize it to add
// metadata, fonts, analytics, or other application-wide document elements.
templ Root(data inertia.RootData) {
	@rootDocument(data, inertiaPageSEO(data))
}

templ rootDocument(data inertia.RootData, seo pageSEO) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ seo.Title }</title>
			@faviconLinks(defaultFaviconBaseURL)
			@seoTags(seo)
			@inertia.SSRHead(data.SSR)
			@templ.Raw(string(data.ViteHead))
		</head>
		<body class="bg-background text-foreground">
			if data.SSR != nil {
				@inertia.SSRBody(data.SSR)
			} else {
				@inertia.PageScript(data.ContainerID, data.PageJSON)
				@inertia.AppMount(data.ContainerID)
			}
			@templ.Raw(string(data.ViteBody))
			if data.Environment == server.ProdEnvironment {
				<script defer data-website-id="8ced4d29-c1ad-46aa-a885-2cf193222376" src="https://analytics.mbvlabs.com/t/script.js"></script>
			}
		</body>
	</html>
}
